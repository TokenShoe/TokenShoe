{
  "name": "tokenshoe",
  "private": true,
  "description": "Shortcuts so web commands can be run from the project root; the app itself lives in web/",
  "scripts": {
    "dev": "cd web && bun run dev",
    "build": "cd web && bun run build",
    "start": "cd web && bun run start",
    "test": "cd web && bun run test",
    "typecheck": "cd web && bun run typecheck",
    "db:migrate": "cd web && bun run db:migrate",
    "db:generate": "cd web && bun run db:generate",
    "db:studio": "cd web && bun run db:studio",
    "e2e": "cd web && bun run e2e",
    "e2e:ui": "cd web && bun run e2e:ui",
    "install:web": "cd web && bun install",
    "deploy:contracts": "./deploy.sh",
    "db:migrate:neon": "cd web && bun run db:migrate:neon"
  }
}
