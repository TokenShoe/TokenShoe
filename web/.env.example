# ── Server ──────────────────────────────────────────────
# One Postgres database per network (same schema). Migrate with: bun run db:migrate / bun run db:migrate:mainnet
# Arc Testnet
DATABASE_URL=postgres://localhost:5432/tokendis
# Arc Mainnet (optional until mainnet goes live; without it, mainnet pages show "not available")
# DATABASE_URL_MAINNET=postgres://localhost:5432/tokendis_mainnet
# Master key that encrypts signer private keys (openssl rand -hex 32) - if lost, stored signer keys can't be decrypted. Back it up!
SIGN_KEY_SECRET=
# Session cookie signing secret (openssl rand -hex 32)
AUTH_SECRET=
# Domain the site is served from (used to validate wallet sign-in); set the real domain in production, e.g. tokendis.xyz
APP_DOMAIN=localhost:3000
# Optional: private server-side RPCs (fall back to the public RPCs in src/config/networks.ts)
# RPC_URL=
# MAINNET_RPC_URL=
# Optional: implementation contract overrides (defaults live in src/config/networks.ts)
# MERKLE_IMPL=0xAc68198e66f46920125D48fAfA978c5067cE4B15
# SIGN_IMPL=0x17968730099016e6679911Ad62603e337d3dcc75
# VESTING_IMPL=0xC4e6Da6235190422E6BC4d3D7a1E0DEd412E3877
# MAINNET_MERKLE_IMPL=
# MAINNET_SIGN_IMPL=
# MAINNET_VESTING_IMPL=
# Signature validity (seconds)
# SIGN_TTL_SECONDS=1800

# ── Shared by frontend and backend (NEXT_PUBLIC_* are baked in at build time - rebuild after changing) ──
# Defaults for both networks live in src/config/networks.ts; these only override them.
# Arc Testnet
# NEXT_PUBLIC_CHAIN_ID=5042002
# NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.io
# NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.arc.io
# NEXT_PUBLIC_FACTORY_ADDRESS=0x865F2f2c7b9D557AEa92f70e8eF05E287E7d00b8
# TestTokenFactory address (written by ./deploy.sh). Set to empty to hide the "mint a test token" feature
# NEXT_PUBLIC_TEST_TOKEN_FACTORY=0x6F846226c060792d2B4934bF9F83760423811eAd
# Arc Mainnet (written by ./deploy.sh mainnet). No factory = mainnet shows "coming soon"
# NEXT_PUBLIC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# NEXT_PUBLIC_MAINNET_EXPLORER_URL=https://explorer.arc.io
# NEXT_PUBLIC_MAINNET_FACTORY_ADDRESS=
# NEXT_PUBLIC_MAINNET_TEST_TOKEN_FACTORY=
# WalletConnect project ID (free at https://cloud.reown.com; without it, mobile wallet QR connection is unavailable)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Local testing only: auto-connect an anvil test account as the wallet (testnet chain id must be 31337; never set in production)
# NEXT_PUBLIC_MOCK_WALLET=1
