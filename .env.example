# ── Contract deployment (read by ./deploy.sh). Copy to .env and fill in; .env is never committed to git ──

# Deployer wallet private key (64 hex chars, 0x optional). Needs Arc testnet USDC for gas: https://faucet.circle.com
PRIVATE_KEY=

# Arc testnet RPC
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# Used by ./deploy.sh mainnet
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# Optional: final factory owner (e.g. a multisig). Leave empty = the deployer wallet itself.
# If set, that address must call acceptOwnership() once after deployment to actually become the owner.
# FACTORY_OWNER=

# Optional: also deploy TestTokenFactory, which lets website users mint a 100M test ERC-20 (default true, on testnet and mainnet).
# Set to false to skip it.
# DEPLOY_TEST_TOKEN_FACTORY=true
